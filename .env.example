# Copy this file to `.env.local` and fill in your details.
# `.env.local` is ignored by Git, so your password is never uploaded.
# The site runs fine without it — the contact form just won't send email.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=website@example.com
