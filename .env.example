# Contact form email delivery (SMTP).
# Copy this file to ".env.local" and fill in real values before deploying.
# The contact form will not send email until these are set.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=davorislimited@yahoo.com
CONTACT_FROM_EMAIL=website@davorislimited.com.ng
